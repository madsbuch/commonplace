{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        }
      ]
    },
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://openrouter.ai/*"
        },
        {
          "url": "https://export.arxiv.org/*"
        },
        {
          "url": "https://arxiv.org/*"
        },
        {
          "url": "https://ar5iv.labs.arxiv.org/*"
        }
      ]
    }
  ]
}
