<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sync finds and talks to the other devices on the local network;
	     without this, macOS's Local Network privacy blocks it silently. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Commonplace syncs your book with your other devices over your local network.</string>
	<!-- Pairing: scanning the code another device shows. -->
	<key>NSCameraUsageDescription</key>
	<string>Commonplace uses the camera to scan the pairing code another device shows.</string>
</dict>
</plist>
